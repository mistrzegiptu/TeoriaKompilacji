Grammar:

Rule 0     S' -> program
Rule 1     program -> instructions_opt
Rule 2     instructions_opt -> <empty>
Rule 3     instructions_opt -> instructions
Rule 4     instructions -> instruction
Rule 5     instructions -> instructions instruction
Rule 6     instruction -> FOR var = range instruction
Rule 7     instruction -> WHILE ( condition ) instruction
Rule 8     instruction -> IF ( condition ) instruction ELSE instruction  [precedence=nonassoc, level=2]
Rule 9     instruction -> IF ( condition ) instruction  [precedence=nonassoc, level=1]
Rule 10    instruction -> { instructions }
Rule 11    instruction -> statement ;
Rule 12    instruction -> assignment ;
Rule 13    range -> expression : expression
Rule 14    condition -> expression < expression  [precedence=nonassoc, level=3]
Rule 15    condition -> expression > expression  [precedence=nonassoc, level=3]
Rule 16    condition -> expression GE expression  [precedence=nonassoc, level=3]
Rule 17    condition -> expression LE expression  [precedence=nonassoc, level=3]
Rule 18    condition -> expression NE expression  [precedence=nonassoc, level=3]
Rule 19    condition -> expression EQ expression  [precedence=nonassoc, level=3]
Rule 20    assignment_op -> =
Rule 21    assignment_op -> ADDASSIGN
Rule 22    assignment_op -> SUBASSIGN
Rule 23    assignment_op -> DIVASSIGN
Rule 24    assignment_op -> MULASSIGN
Rule 25    assignment -> vector_element assignment_op expression
Rule 26    assignment -> matrix_element assignment_op expression
Rule 27    assignment -> var assignment_op expression
Rule 28    matrix_function -> matrix_function_name ( expression , expression )
Rule 29    matrix_function -> matrix_function_name ( expression )
Rule 30    matrix_function_name -> ZEROS
Rule 31    matrix_function_name -> ONES
Rule 32    matrix_function_name -> EYE
Rule 33    matrix -> [ rows ]
Rule 34    rows -> row
Rule 35    rows -> rows ; row
Rule 36    row -> variables
Rule 37    variables -> variable
Rule 38    variables -> variables , variable
Rule 39    variable -> element
Rule 40    variable -> var
Rule 41    variable -> number
Rule 42    uminus -> - expression  [precedence=right, level=6]
Rule 43    element -> vector_element
Rule 44    element -> matrix_element
Rule 45    vector_element -> ID [ expression ]
Rule 46    matrix_element -> ID [ expression , expression ]
Rule 47    var -> ID
Rule 48    number -> INTNUM
Rule 49    number -> FLOATNUM
Rule 50    string -> STRING
Rule 51    statement -> PRINT print_vals
Rule 52    statement -> RETURN expression
Rule 53    statement -> BREAK
Rule 54    statement -> CONTINUE
Rule 55    print_vals -> print_val
Rule 56    print_vals -> print_vals , print_val
Rule 57    print_val -> expression
Rule 58    expression -> string
Rule 59    expression -> uminus
Rule 60    expression -> vector_element
Rule 61    expression -> matrix_element
Rule 62    expression -> transposition
Rule 63    expression -> matrix_function
Rule 64    expression -> matrix
Rule 65    expression -> num_expression
Rule 66    expression -> ( expression )
Rule 67    expression -> expression DOTDIV expression  [precedence=left, level=5]
Rule 68    expression -> expression DOTMUL expression  [precedence=left, level=5]
Rule 69    expression -> expression DOTSUB expression  [precedence=left, level=4]
Rule 70    expression -> expression DOTADD expression  [precedence=left, level=4]
Rule 71    expression -> expression / expression  [precedence=left, level=5]
Rule 72    expression -> expression * expression  [precedence=left, level=5]
Rule 73    expression -> expression - expression  [precedence=left, level=4]
Rule 74    expression -> expression + expression  [precedence=left, level=4]
Rule 75    num_expression -> var
Rule 76    num_expression -> number
Rule 77    transposition -> expression '  [precedence=left, level=7]

